# The Flutter app does NOT read .env files. Public build-time values go in
# config/app_config.json (copy config/app_config.example.json) and are passed with
#   flutter build apk --dart-define-from-file=config/app_config.json
# Everything compiled into the app is public. Server secrets belong ONLY in backend/.env
# (see backend/.env.example): SUPABASE_SERVICE_ROLE_KEY, AI_API_KEY, DATABASE_URL, ...
SUPABASE_URL=
SUPABASE_ANON_KEY=
API_BASE_URL=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
