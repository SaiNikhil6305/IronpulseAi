# IronPulse backend configuration. Copy to .env and fill in. NEVER commit real values.
ENVIRONMENT=development            # development | test | production
DATABASE_URL=sqlite:///./ironpulse_dev.db
# Production (Supabase Postgres, direct or pooled connection string from Project Settings > Database):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Only for legacy projects that still sign tokens with the shared JWT secret. Leave empty for JWKS (recommended).
SUPABASE_JWT_SECRET=
# Server-only. Used solely for account deletion (auth user + storage cleanup). Never put this in the app.
SUPABASE_SERVICE_ROLE_KEY=
PROGRESS_PHOTO_BUCKET=progress-photos

# --- IronPulse AI (server-only) ---
AI_PROVIDER=                       # anthropic | openai_compatible | (empty = AI disabled)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=                       # required for openai_compatible, e.g. https://api.example.com/v1
AI_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_MINUTE=6
AI_DAILY_MESSAGE_LIMIT=50

# --- Operations ---
API_RATE_LIMIT_PER_MINUTE=240
MAX_REQUEST_BYTES=1000000
LOG_LEVEL=INFO
